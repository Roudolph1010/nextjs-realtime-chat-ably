{
  "name": "ably-nextjs-vercel-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "debug": "node --inspect-brk ./node_modules/next/dist/bin/next",
    "lint": "next lint",
    "format": "prettier --write --ignore-path .gitignore app components",
    "format:check": "prettier --check --ignore-path .gitignore app components",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui --ui-host=127.0.0.1",
    "test:e2e:report": "playwright show-report --host 127.0.0.1"
  },
  "dependencies": {
    "@ably/chat": "^0.6.0",
    "ably": "2.8.0",
    "next": "^14.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "eslint": "8.57.0",
    "eslint-config-next": "^13.4.19",
    "prettier": "^3.2.5"
  },
  "overrides": {
    "rimraf": "^4.0.0",
    "glob": "^9.0.0",
    "inflight": "npm:lru-cache@^10.0.0"
  }
}
